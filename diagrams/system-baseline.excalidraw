      "updated": 1791849600000,
      "link": null,
      "locked": false,
      "text": "02  No authorization or CSRF checks",
      "originalText": "02  No authorization or CSRF checks",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "e31",
      "type": "text",
      "x": 593,
      "y": 709,
      "width": 401.0,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 130,
      "version": 1,
      "versionNonce": 330,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791849600000,
      "link": null,
      "locked": false,
      "text": "Book IDs are accepted without ownership checks.\nAnyone can read, edit, or delete records.\nState changes have no CSRF validation.",
      "originalText": "Book IDs are accepted without ownership checks.\nAnyone can read, edit, or delete records.\nState changes have no CSRF validation.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
