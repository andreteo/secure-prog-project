      "versionNonce": 333,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791849600000,
      "link": null,
      "locked": false,
      "text": "User inputs are concatenated into SQL.\nNo server-side field or size validation.\nRaw note HTML may execute scripts.",
      "originalText": "User inputs are concatenated into SQL.\nNo server-side field or size validation.\nRaw note HTML may execute scripts.",
      "fontSize": 18,
