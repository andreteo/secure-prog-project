      "versionNonce": 336,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791849600000,
      "link": null,
      "locked": false,
      "text": "Every request reaches application processing.\nRepeated requests can consume resources.\nThere is no throttling or backoff.",
      "originalText": "Every request reaches application processing.\nRepeated requests can consume resources.\nThere is no throttling or backoff.",
