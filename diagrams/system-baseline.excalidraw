      "boundElements": null,
      "updated": 1791849600000,
      "link": null,
      "locked": false,
      "text": "Browser-to-server traffic uses HTTP.\nRequests and private notes are unencrypted.\nTraffic can be observed or modified in transit.",
      "originalText": "Browser-to-server traffic uses HTTP.\nRequests and private notes are unencrypted.\nTraffic can be observed or modified in transit.",
