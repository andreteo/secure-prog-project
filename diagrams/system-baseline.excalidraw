      "link": null,
      "locked": false,
      "text": "01  No authentication or sessions",
      "originalText": "01  No authentication or sessions",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "e28",
      "type": "text",
      "x": 78,
      "y": 709,
      "width": 345.0,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 127,
      "version": 1,
      "versionNonce": 327,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791849600000,
      "link": null,
      "locked": false,
      "text": "Caller supplies a user ID without proving it.\nNo login verification or session lifecycle.\nAnyone can impersonate another user.",
      "originalText": "Caller supplies a user ID without proving it.\nNo login verification or session lifecycle.\nAnyone can impersonate another user.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
