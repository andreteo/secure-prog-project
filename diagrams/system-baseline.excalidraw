      "boundElements": null,
      "updated": 1791849600000,
      "link": null,
      "locked": false,
      "text": "No project-specific database-file restrictions.\nDebug errors may reveal internal details.\nNo configured protective response headers.",
      "originalText": "No project-specific database-file restrictions.\nDebug errors may reveal internal details.\nNo configured protective response headers.",
