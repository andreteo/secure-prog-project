      "versionNonce": 223,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791849600000,
      "link": null,
      "locked": false,
      "text": "1  Browser input is untrusted. The API enforces every access decision.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1  Browser input is untrusted. The API enforces every access decision.",
      "autoResize": true,
      "lineHeight": 1.25
    },
