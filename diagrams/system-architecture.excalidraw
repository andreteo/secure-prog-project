      "updated": 1791849600000,
      "link": null,
      "locked": false,
      "text": "2  Proxy \u2192 API is assumed local to the host; reassess transport protection if moved across hosts.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
